<?php

$name = $_POST['name'];
$height = $_POST['height'];
$weight = $_POST['weight'];

$bmi = $weight / ($height * $height);

if($bmi < 18.5)
{
    $status = "Underweight";
    $recommendation = "Increase your calorie intake and eat a balanced, nutritious diet.";
}
elseif($bmi < 25)
{
    $status = "Normal Weight";
    $recommendation = "Maintain a healthy diet and exercise regularly.";
}
elseif($bmi < 30)
{
    $status = "Overweight";
    $recommendation = "Exercise regularly and reduce high-calorie foods.";
}
else
{
    $status = "Obese";
    $recommendation = "Consult a healthcare professional and follow a healthy lifestyle plan.";
}

?>

